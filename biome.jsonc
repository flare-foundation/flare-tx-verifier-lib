{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    // registry.ts is generated data.
    "includes": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "!src/evm/contract/registry.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
