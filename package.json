{
  "name": "@flarenetwork/flare-tx-verifier-lib",
  "version": "1.4.0",
  "description": "A library for verifying Flare C-chain and P-chain transactions.",
  "main": "dist/index.js",
  "files": [
    "/dist"
  ],
  "types": "dist/index.d.ts",
